// Windows resources for openbrc.exe.
#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/packaging/icons/openbrc.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenBRC contributors"
            VALUE "FileDescription", "OpenBRC"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "openbrc"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Barbie is a trademark of Mattel, Inc."
            VALUE "OriginalFilename", "openbrc.exe"
            VALUE "ProductName", "OpenBRC"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
